@startuml "Diagrama de classes com relacionamentos"
skinparam classAttributeIconSize 0
hide circle
left to right direction

interface Reproduzivel <<interface>> extends Cronometravel {
  ~reproduzir(): void
}

interface Faturavel <<interface>> {
  ~calcularMensalidade(): double
}

interface Cronometravel <<interface>> {
  ~getDuracaoSegundos(): int
  ~getDuracaoFormatada(): String
}

abstract class Conteudo implements Reproduzivel {
  -{static} contador: int = 0
  #id: int
  #titulo: String
  #duracaoSegundos: int
  -reproducoes: int = 0
  --
  +Conteudo(titulo: String, duracaoSegundos: int)
  +{static} getProximoId(): int
  +getId(): int
  #setId(id: int): void
  +getTitulo(): String
  +setTitulo(titulo: String): void
  +getDuracaoSegundos(): int
  +setDuracaoSegundos(duracaoSegundos: int): void
  +getReproducoes(): int
  +{abstract} getCreditos(): String
  +{final} reproduzir(): void
  +getDuracaoFormatada(): String
  +toString(): String
}

class Musica extends Conteudo {
  -album: String
  -artista: String
  --
  +Musica(titulo: String, artista: String, duracaoSegundos: int)
  +Musica(titulo: String, artista: String, album: String, duracaoSegundos: int)
  +getAlbum(): String
  +setAlbum(album: String): void
  +getArtista(): String
  +setArtista(artista: String): void
  +getCreditos(): String
  +toString(): String
}

class Podcast extends Conteudo {
  -apresentador: String
  -numeroEpisodio: int
  --
  +Podcast(titulo: String, apresentador: String, duracaoMinutos: int, numeroEpisodio: int)
  +getDuracaoMinutos(): int
  +getApresentador(): String
  +setApresentador(apresentador: String): void
  +getNumeroEpisodio(): int
  +setNumeroEpisodio(numeroEpisodio: int): void
  +getCreditos(): String
  +toString(): String
}

abstract class Plano implements Faturavel {
  -nome: String
  -maxDispositivos: int
  --
  #Plano(nome: String, maxDispositivos: int)
  +getNome(): String
  +getMaxDispositivos(): int
  +{abstract} temAnuncios(): boolean
  +{abstract} calcularMensalidade(): double
  +{final} resumo(): String
}

abstract class PlanoPago extends Plano {
  -precoMensal: double
  --
  #PlanoPago(nome: String, maxDispositivos: int, precoMensal: double)
  +getPrecoMensal(): double
  +setPrecoMensal(precoMensal: double): void
  +temAnuncios(): boolean
}

class PlanoGratuito <<final>> extends Plano {
  +PlanoGratuito()
  +temAnuncios(): boolean
  +calcularMensalidade(): double
}

class PlanoIndividual extends PlanoPago {
  +PlanoIndividual(precoMensal: double)
  +calcularMensalidade(): double
}

class PlanoFamilia extends PlanoPago {
  -quantidadeMembros: int
  --
  +PlanoFamilia(precoMensal: double, quantidadeMembros: int)
  +getQuantidadeMembros(): int
  +setQuantidadeMembros(quantidadeMembros: int): void
  +calcularMensalidade(): double
}

class Plataforma {
  -usuarios: ArrayList<Usuario> = new ArrayList<>()
  -conteudos: ArrayList<Conteudo> = new ArrayList<>()
  -anuncios: ArrayList<Anuncio> = new ArrayList<>()
  --
  +getUsuarios(): ArrayList<Usuario>
  +getTotalUsuarios(): int
  +cadastrarUsuario(usuario: Usuario): boolean
  +cadastrarUsuarios(usuarios: ArrayList<Usuario>): boolean
  +buscarUsuario(id: int): Usuario
  +buscarUsuario(nome: String): Usuario
  +calcularReceitaMensal(): double
  +getConteudos(): ArrayList<Conteudo>
  +getTotalConteudos(): int
  +cadastrarConteudo(conteudo: Conteudo): boolean
  +cadastrarConteudos(conteudos: ArrayList<Conteudo>): boolean
  +buscarConteudoPorId(id: int): Conteudo
  +buscarConteudo(titulo: String): Conteudo
  +listarApresentadoresDePodcast(): ArrayList<String>
  +listarEpisodiosDe(nomeApresentador: String): ArrayList<Podcast>
  +cadastrarAnuncio(anuncio: Anuncio): void
  +cadastrarAnuncios(anuncios: ArrayList<Anuncio>): boolean
  +buscarAnuncio(titulo: String): Anuncio
  +tocarPlaylist(ouvinte: Usuario, playlist: Playlist): void
}

class Usuario {
  -{static} proximoId: int = 1
  -id: int
  -nome: String
  -email: String
  -plano: Plano
  -seguindo: ArrayList<Usuario> = new ArrayList<>()
  --
  +Usuario(nome: String, email: String)
  -{static} validarParametrosUsuario(nome: String, email: String): void
  +{static} getProximoId(): int
  +getId(): int
  +getNome(): String
  +getEmail(): String
  +getPlano(): Plano
  +assinar(novoPlano: Plano): void
  +seguir(outro: Usuario): void
  +deixarDeSeguir(outro: Usuario): void
  +getQuantidadeSeguindo(): int
  +getSeguindo(): ArrayList<Usuario>
}

class Playlist {
  -dono: Usuario
  -nome: String
  -conteudos: ArrayList<Conteudo> = new ArrayList<>()
  --
  +Playlist(nome: String, dono: Usuario)
  -{static} validarParametrosPlaylist(nome: String, dono: Usuario): void
  +getDono(): Usuario
  +getNome(): String
  +getArrayConteudos(): ArrayList<Conteudo>
  +buscarConteudoPorId(id: int): Conteudo
  +getQuantidade(): int
  +getNaPosicao(indice: int): Conteudo
  +adicionar(conteudos: Conteudo): void
  +adicionar(conteudo: Conteudo): void
  +removerNaPosicao(indice: int): boolean
  +getDuracaoTotalSegundos(): int
  +reproduzirTudo(): void
}

class Anuncio implements Reproduzivel, Faturavel {
  -anunciante: String
  -titulo: String
  -duracaoSegundos: int
  -valorPorMilImpressoes: int
  -impressoes: int = 0
  --
  +Anuncio(anunciante: String, titulo: String, duracaoSegundos: int, valorPorMilImpressoes: int)
  +getAnunciante(): String
  +setAnunciante(anunciante: String): void
  +getTitulo(): String
  +setTitulo(titulo: String): void
  +getDuracaoSegundos(): int
  +setDuracaoSegundos(duracaoSegundos: int): void
  +getValorPorMilImpressoes(): int
  +setValorPorMilImpressoes(valorPorMilImpressoes: int): void
  +getImpressoes(): int
  +reproduzir(): void
  +calcularValorVeiculacao(): double
  +calcularMensalidade(): double
}

Plataforma "1" --> "0..*" Conteudo : plataforma / cataloga / acervo
Plataforma "1" --> "0..*" Usuario : plataforma / registra / usuarios
Plataforma "1" --> "0..*" Anuncio : plataforma / exibe / anuncios
Playlist "0..*" --> "1" Usuario : playlists / pertence a / dono
Playlist "0..*" --> "0..*" Conteudo : playlists / contem / faixas
Usuario "0..*" --> "0..*" Usuario : seguindo / segue / seguidores
Usuario "0..*" --> "1" Plano : usuarios / assina / plano

@enduml