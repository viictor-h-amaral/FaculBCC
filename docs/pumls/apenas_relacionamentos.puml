@startuml "Diagrama com relacionamentos"
skinparam classAttributeIconSize 0
hide circle
left to right direction

class Plataforma {
  - nome: String
  --
  + cadastrarUsuario(usuario: Usuario): boolean
  + cadastrarMusica(musica: Musica): boolean
  + buscarMusicaPorId(id: int): Musica
  + buscarUsuario(nome: String): Usuario
}

class Playlist {
  - nome: String
  --
  + adicionar(musica: Musica): boolean
  + getDuracaoTotalSegundos(): int
  + reproduzirTudo(): void
}

class Usuario {
  - id: int
  - nome: String
  - email: String
  --
  + seguir(outro: Usuario): void
  + deixarDeSeguir(outro: Usuario): void
  + getQuantidadeSeguindo(): int
}

abstract class Conteudo {
  #id: int
  #titulo: String
  #duracaoSegundos: int
  -reproducoes: int = 0
  --
  +{abstract} getCreditos(): String
  +{final} reproduzir(): void
  +getDuracaoFormatada(): String
  +toString(): String
}

class Anuncio {
  -anunciante: String
  -titulo: String
  -duracaoSegundos: int
  -valorPorMilImpressoes: int
  -impressoes: int = 0
  --
  +reproduzir(): void
  +calcularValorVeiculacao(): double
  +calcularMensalidade(): double
}

Plataforma "1" --> "0..*" Conteudo : plataforma / cataloga / acervo
Plataforma "1" --> "0..*" Usuario : plataforma / registra / usuarios
Plataforma "1" --> "0..*" Anuncio : plataforma / exibe / anuncios
Playlist "0..*" --> "1" Usuario : playlists / pertence a / dono
Playlist "0..*" --> "0..*" Conteudo : playlists / contem / faixas
Usuario "0..*" --> "0..*" Usuario : seguindo / segue / seguidores

@enduml